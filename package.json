{
  "name": "ugle-main",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/check-env.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "tsx scripts/create-test-db.ts && vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "perf": "tsx scripts/load-check.ts",
    "payload": "bun --bun ./node_modules/payload/bin.js --disable-transpile",
    "generate:types": "bun run payload generate:types",
    "generate:importmap": "bun run payload generate:importmap",
    "migrate": "bun run payload migrate",
    "migrate:create": "bun run payload migrate:create",
    "seed": "bun --bun scripts/seed/index.ts",
    "ci": "payload migrate && next build"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.3",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.9",
    "@next/third-parties": "^16.3.0",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/live-preview-react": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/plugin-redirects": "3.93.0",
    "@payloadcms/plugin-seo": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/storage-vercel-blob": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@react-email/render": "^2.0.10",
    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "disposable-domains": "^2.0.6",
    "googleapis": "^173.0.0",
    "graphql": "16.8.1",
    "lucide-react": "^1.21.0",
    "motion": "^12.41.0",
    "next": "16.3.8",
    "payload": "3.93.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.1",
    "sharp": "^0.35.5",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "happy-dom": "20.14.5",
    "jsdom": "^31.0.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
