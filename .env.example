# Resend
ADMIN_EMAIL=admin@example.com
# Use a verified sending domain in production, e.g. no-reply@contact.ugle.ai
RESEND_FROM_EMAIL=delivered@resend.dev
RESEND_API_KEY=re_Kxxxxxxxxxxxxxxxxxxxxxxxx

# Payments
# Keep false until launch day. While false, the pricing CTAs point to
# /request-trial. Set to true to send India visitors to Cashfree and all other
# visitors to Dodo Payments.
PAYMENTS_LIVE=false

# Google Sheets Details
GOOGLE_CLIENT_EMAIL="client@client.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIdasdsagASdmsae...E==\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID="12sxxxxxxxxxxxxxxxxx-xxxxxx"

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=3x00000000000000000000FF
TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA

# IP rate limiting
# Backed by the Cloudflare Worker in workers/rate-limit (see its README).
# Leave both blank to disable IP limits entirely (fails open).
RATE_LIMIT_WORKER_URL=
RATE_LIMIT_WORKER_SECRET=

# Payload CMS
PAYLOAD_SECRET="<random 32+ char string>"
DATABASE_URI="postgres://ugle:ugle@localhost:5432/ugle"
# Production: postgres://user:password@host/db?sslmode=require  (Neon pooled)
# or @payloadcms/db-vercel-postgres: POSTGRES_URL="postgres://..."

# Media (Vercel Blob)
# The store must be created with PUBLIC access: the CMS uploads with
# `access: 'public'` and the site embeds the blob URL directly. Access mode
# cannot be changed after a store is created, and a private store rejects
# browser uploads with a 400 that surfaces as a CORS error.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Site / preview
NEXT_PUBLIC_SERVER_URL="https://ugle.ai"
PREVIEW_SECRET="<random 32+ char string>"

# Scheduled publishing (Vercel Cron → /api/payload-jobs/run)
CRON_SECRET="<random 32+ char string>"

# First admin (seed only; never expose to the client)
SEED_ADMIN_EMAIL="admin@ugle.ai"
SEED_ADMIN_PASSWORD="<strong temporary password>"
SEED_ADMIN_NAME="Ugle Admin"
