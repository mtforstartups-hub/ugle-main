{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ugle-rate-limit",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    // Fixed window limits per IP. Tune here and redeploy.
    "HOURLY_LIMIT": "5",
    "DAILY_LIMIT": "15",
    // How long a claimed email stays reserved (one trial per inbox).
    "CLAIM_TTL_DAYS": "180"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiter"]
    }
  ]
}
